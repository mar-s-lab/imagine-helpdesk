# Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# ===========================================
# Basecamp OAuth Configuration (Admin Setup)
# ===========================================
# These variables are set in Supabase Edge Function secrets
# NOT in the frontend .env file
#
# To set up Basecamp OAuth:
# 1. Go to https://launchpad.37signals.com/integrations
# 2. Create a new integration/app
# 3. Set the redirect URI to: https://your-project.supabase.co/functions/v1/basecamp-callback
# 4. Copy the Client ID and Client Secret
# 5. Set these secrets in Supabase:
#
# supabase secrets set BASECAMP_CLIENT_ID=your-client-id
# supabase secrets set BASECAMP_CLIENT_SECRET=your-client-secret
# supabase secrets set BASECAMP_REDIRECT_URI=https://your-project.supabase.co/functions/v1/basecamp-callback
# supabase secrets set APP_URL=https://your-app-domain.com
